# WANDB
WANDB_API_KEY=e9d88303ceecaf6037cfc47d3a8fa275211b138d

# JQuants API認証情報
JQUANTS_AUTH_EMAIL=wer.inc.jp@gmail.com
JQUANTS_AUTH_PASSWORD=aBcDeF123456

# 旧形式の環境変数名（互換性のため）
JQUANTS_EMAIL=wer.inc.jp@gmail.com
JQUANTS_PASSWORD=aBcDeF123456

# JQuants Plan Tier (Premium for futures & full features)
JQUANTS_PLAN_TIER=premium

# BigQuery設定（将来用）
GOOGLE_APPLICATION_CREDENTIALS=/root/gogooku3/secrets/gogooku-b3b34bc07639.json

# その他の設定
DEBUG=0
TZ=Asia/Tokyo

# プロジェクト設定
PROJECT_NAME=gogooku3
OUTPUT_DIR=/home/ubuntu/gogooku3/output
LOG_LEVEL=INFO

# JQuants API契約範囲（オプション）
# Note: API契約範囲の検証にのみ使用（データ取得範囲には影響しない）
#
# ローリング契約（直近N年）の場合: JQUANTS_CONTRACT_YEARS を設定
JQUANTS_CONTRACT_YEARS=10  # 直近10年の契約（今日から10年前まで）
#
# 固定開始日の契約の場合: JQUANTS_SUBSCRIPTION_START を設定
# JQUANTS_SUBSCRIPTION_START=2015-10-13  # ライトプラン以上の固定契約
# JQUANTS_SUBSCRIPTION_END=  # 空の場合は現在日付まで

# データ取得設定（安定優先の並列度）
MAX_CONCURRENT_FETCH=16  # API安定性優先の控えめ設定
JQUANTS_PARALLEL_CONCURRENCY=16  # レガシー互換（MAX_CONCURRENT_FETCHに合わせる）
INDEX_OPTION_PARALLEL_CONCURRENCY=4  # Index Options並列度（過負荷防止）
REQUEST_TIMEOUT_SECONDS=30  # 長時間ハング防止
USE_CACHE=1  # 価格データのキャッシュを有効化
CACHE_MAX_AGE_DAYS=90  # キャッシュ有効期限（2TiB RAM環境：30日→90日に延長）
ENABLE_MULTI_CACHE=1  # 複数キャッシュファイル結合（Phase 2最適化）
MIN_CACHE_COVERAGE=0.3  # 最小キャッシュカバレッジ閾値
# ML_PIPELINE_START_DATE=2015-10-13  # オプション: 過去データの強制取得（通常は不要）

# GPU設定
FORCE_GPU=1
REQUIRE_GPU=1
USE_GPU_ETL=1
RMM_ALLOCATOR=cuda_async
RMM_POOL_SIZE=40GB  # GPU-ETL pool for A100 80GB
CUDF_SPILL=1
CUDA_VISIBLE_DEVICES=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Numba/RAPIDS compatibility fix
NUMBA_CUDA_ENABLE_PYNVJITLINK=1

# GPU学習デフォルト設定
GPU_TRAINING_ENABLED=1
DEFAULT_LEARNING_RATE=2e-4
DEFAULT_MAX_EPOCHS=75
ADV_GRAPH_TRAIN=1

# DataLoader最適化設定
PREFETCH_FACTOR=8  # バッチプリフェッチ数（バッチ準備時間を短縮）

# Safe mode 設定（FORCE_SINGLE_PROCESS=1時に適用）
SAFE_MODE_BATCH_SIZE=512  # Safe mode初期バッチサイズ（2TiB RAM環境で256→512に増加）
# Note: Safe mode時はPyTorchスレッドも自動的に1に制限されます（デッドロック防止）

# 最適化モード設定（2TiB RAM + A100 80GB環境）
OPTIMIZED_BATCH_SIZE=4096  # 最適化モードバッチサイズ（大容量RAM環境）
MAX_PARALLEL_WORKERS=32     # CPU並列処理（256コアの12%活用）
ALLOW_UNSAFE_DATALOADER=1   # Multi-worker DataLoader有効化
NUM_WORKERS=12              # DataLoader workers（メモリ豊富なので増加）
PERSISTENT_WORKERS=1        # Worker再利用でメモリ効率化
PIN_MEMORY=1                # GPU転送高速化

# GCS (Google Cloud Storage) 設定
GCS_ENABLED=1
GCS_BUCKET=gogooku-ml-data
GCS_CREDENTIALS_PATH=/workspace/gogooku3/secrets/gogooku-b3b34bc07639.json
GCS_SYNC_AFTER_SAVE=1
GCS_DELETE_LOCAL_AFTER_SYNC=0  # Keep local copy (set to 1 for auto-delete after GCS sync)
LOCAL_CACHE_DIR=/workspace/gogooku3/output
GOOGLE_APPLICATION_CREDENTIALS=/workspace/gogooku3/secrets/gogooku-b3b34bc07639.json
# === IC=0 Fix Settings (Added 2025-10-15) ===
MC_DROPOUT_VAL=1          # Enable MC Dropout during validation
PRED_VAR_MIN=0.01         # Prediction variance threshold (doubled from 0.005)
PRED_VAR_WEIGHT=0.3       # Prediction variance penalty (tripled from 0.1)

# === Training Goal Settings (Added 2025-10-15) ===
# Target: Sharpe Ratio = 0.849 (from CLAUDE.md)

# Early Stopping Configuration (Optimized for overfitting prevention)
EARLY_STOP_METRIC=val_rankic     # Monitor RankIC (financial metric)
EARLY_STOP_MAXIMIZE=1            # Higher RankIC is better
EARLY_STOP_PATIENCE=5            # Reduced from 12 to prevent overfitting
EARLY_STOP_MIN_DELTA=0.002       # Increased from 0.001 for stricter criteria

# Regularization (Overfitting prevention - added 2025-10-18)
WEIGHT_DECAY=2e-5                # L2 regularization (increased from 1e-5)
DROPOUT_RATE=0.25                # Dropout rate (increased from 0.2)
GRADIENT_CLIP_NORM=0.5           # Gradient clipping (reduced from 1.0 for stability)

# Checkpoint Saving Strategy
SAVE_BEST_RANKIC=1               # Save best RankIC model (for production)
SAVE_BEST_SHARPE=1               # Save best Sharpe model (for evaluation)
SAVE_PHASE_CHECKPOINTS=1         # Save snapshot at end of each phase
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # Optional: for GitHub API

# Loss Function Weights (Production optimization - Added 2025-10-19)
USE_RANKIC=1
RANKIC_WEIGHT=0.5
CS_IC_WEIGHT=0.3
SHARPE_WEIGHT=0.1

# Phase-based Loss Weights (Added 2025-10-19)
# Format: "phase:metric1=weight1,metric2=weight2|phase:..."
# Phase 0: MSE only (baseline convergence)
# Phase 1: MSE + RankIC (introduce rank correlation)
# Phase 2: RankIC + Sharpe (financial metrics focus)
PHASE_LOSS_WEIGHTS="0:mse=1.0|1:mse=0.5,rankic=0.3|2:rankic=0.5,sharpe=0.3"

# Torch compile configuration (performance)
# Options: disable, reduce-overhead, default, max-autotune
TORCH_COMPILE_MODE=max-autotune

# Dataset/RAW settings
USE_RAW_STORE=1  # 既存のrawスナップショットを再利用
SAVE_RAW_DATA=1  # Enable raw API data saving (2020-2021 period only, limited by quota)

# Temporary directory settings (use /tmp to avoid quota issues)
TMPDIR=/tmp
TEMP=/tmp
TMP=/tmp

# Default fetch window for duckdb-fetch-listed
START=2020-01-01
END=2025-11-20

# Throttle listed_info fetch every 10 days (seconds)
SLEEP_SEC=2.0

# Feature computation warmup window (used by compute-features)
WARMUP_DAYS=260
